{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cafe-ordering",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // The dashboard's built files (admin/ builds into public/admin). The Worker runs first for every
  // request and serves them itself under /admin/ (src/dashboard.ts, D-71).
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": {
    "bindings": [
      // One CafeDO per café; its name is the venue ID.
      { "name": "CAFE", "class_name": "CafeDO" },
      // One DirectoryDO for the whole system (name "directory"): lookups that don't know their café.
      { "name": "DIRECTORY", "class_name": "DirectoryDO" }
    ]
  },
  // Cloudflare Access (dashboard login, D-12). Fill in from Zero Trust > Access > Applications
  // once the domain exists. Until then the admin API refuses every request (no valid tokens).
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://CHANGE-ME.cloudflareaccess.com",
    "ACCESS_AUD": "CHANGE-ME"
  },
  "migrations": [
    // SQLite-backed Durable Objects are the only kind allowed on the Workers Free plan.
    { "tag": "v1", "new_sqlite_classes": ["CafeDO"] },
    { "tag": "v2", "new_sqlite_classes": ["DirectoryDO"] }
  ]
  // Secrets (never in this file): SERVER_SECRET, INSTALLER_SECRET.
  // Set each with `npx wrangler secret put <NAME>`.
  // For local dev, copy .dev.vars.example to .dev.vars.
}
